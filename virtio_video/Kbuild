#
# Kbuild for the virtio-video driver
#

# Same version and uapi/ include path as the ddk_module target in ../BUILD.bazel
ccflags-y += -DDRIVER_VERSION=\"android14-6.1\"

virtio_video-y := \
	virtio_video_driver.o \
	virtio_video_vq.o \
	virtio_video_device.o \
	virtio_video_dec.o \
	virtio_video_enc.o \
	virtio_video_cam.o \
	virtio_video_caps.o \
	virtio_video_helpers.o

obj-m += virtio_video.o
LINUXINCLUDE := -I$(kbuild-dir)/../uapi ${LINUXINCLUDE}
