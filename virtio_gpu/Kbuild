obj-m += virtio-gpu.o
# Locate uapi/ from this directory, so the modules also build when this repo is not
# checked out at $(srctree)/../common-modules/virtual-device (e.g. M=<absolute path>)
LINUXINCLUDE := -I$(if $(filter /%,$(src)),$(src),$(srctree)/$(src))/../uapi ${LINUXINCLUDE}
